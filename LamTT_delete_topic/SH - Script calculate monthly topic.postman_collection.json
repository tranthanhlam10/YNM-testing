				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.environment.set(\"topic_id\", 10228190);",
							"pm.environment.set(\"domain\", \"http://solr-testing.ynm.local\");",
							"pm.environment.set(\"token\", \"ya29.a0AeXRPp5f_w-cugjVU5DgXCfvNtsYO65-IZTUurQbfXRj80Tu77XGld2QHeaRARui8twh-ZYLlmk-554kKMNrZ3SEhwNEzjHb3D9L_l_mHv0R5BKNEj4V3g3RN_56ebL_TEPHcUhTCUFFxceD7TDF5V8x9L8T71yvJYkW1-OlSHcmSpQaCgYKAfsSARMSFQHGX2MiF37DqlmzyZIBNUC0AUhvOw0182\");",
							"const calculate_month = \"11/2024\";",
							"",
							"",
							"",
							"function convertToShard(dateString) {",
							"  ",
							"  const parts = dateString.split(\"/\");",
							"  ",
							"  const month = parts[0];",
							"  const year = parts[1];",
							"  ",
							"  const shard = year + month;",
							"  ",
							"  return shard;",
							"}",
							"",
							"const shard = convertToShard(calculate_month);",
							"pm.environment.set(\"shard\", shard);",
							"",
							"",
							"function getMonthRange(monthYear) {",
							"",
							"    const [month, year] = monthYear.split('/').map(num => parseInt(num, 10));",
							"    const firstDayUTC = new Date(Date.UTC(year, month - 1, 1, 0, 0, 0));",
							"    const lastDayUTC = new Date(Date.UTC(year, month, 0, 23, 59, 59));",
							"    ",
							"    ",
							"    const firstDayAdjusted = new Date(firstDayUTC);",
							"    firstDayAdjusted.setHours(firstDayUTC.getHours() - 7);",
							"    ",
							"    const lastDayAdjusted = new Date(lastDayUTC);",
							"    lastDayAdjusted.setHours(lastDayUTC.getHours() - 7);",
							"    ",
							"    const firstDayFormatted = firstDayAdjusted.toISOString().slice(0, 19) + 'Z';",
							"    const lastDayFormatted = lastDayAdjusted.toISOString().slice(0, 19) + 'Z';",
							"    ",
							"    return {",
							"        startDate: firstDayFormatted,",
							"        endDate: lastDayFormatted",
							"    };",
							"}",
							"",
							"// Example usage",
							"const result = getMonthRange(calculate_month);",
							"console.log(result);",
							"pm.environment.set(\"startDate\", result.startDate);",
							"pm.environment.set(\"endDate\", result.endDate);",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
